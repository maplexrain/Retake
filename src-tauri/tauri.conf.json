{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Retake",
  "version": "0.1.0",
  "identifier": "com.retake.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Retake",
        "width": 680,
        "height": 240,
        "minWidth": 580,
        "minHeight": 200,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.png"]
  }
}
